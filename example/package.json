{
  "name": "Example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx  --max-warnings 0 --cache --fix",
    "tsc": "tsc --noEmit",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "web": "IS_WEB_BUILD=true react-native start --port 8095",
    "build:web": "node scripts/build-web.js",
    "pod:install:ios": "pod install --project-directory=ios",
    "bundle:ios": "mkdir -p dist && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/main.ios.jsbundle --assets-dest dist",
    "build:android": "cd android && ./gradlew assembleDebug --warning-mode all",
    "build:ios": "react-native build-ios --scheme Example --mode Debug --extra-params \"-sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO CLANG_CXX_LANGUAGE_STANDARD=c++20\"",
    "mkdist": "node -e \"require('node:fs').mkdirSync('dist', { recursive: true, mode: 0o755 })\""
  },
  "dependencies": {
    "@react-native/assets-registry": "0.88.1",
    "@react-navigation/elements": "^2.9.46",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/stack": "7.12.2",
    "babel-plugin-transform-inline-environment-variables": "^0.4.4",
    "mediabunny": "1.66.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "^2.33.0",
    "react-native-nitro-modules": "0.37.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.30.1",
    "react-native-skia": "3.10.0",
    "react-native-web": "^0.21.2",
    "react-native-webcodecs": "workspace:*",
    "react-native-webgpu": "0.23.0",
    "react-native-worklets": "0.13.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native-community/cli-platform-android": "^20.2.0",
    "@react-native-community/cli-platform-ios": "^20.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@rnx-kit/metro-config": "^2.0.0",
    "@types/node": "^20.14.7",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "@webgpu/types": "0.1.65",
    "babel-jest": "^29.6.3",
    "eslint": "9.35.0",
    "eslint-config-react-native-wcandillon": "5.0.1",
    "eslint-plugin-prettier": "^5.4.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-native-test-app": "5.4.17",
    "react-test-renderer": "19.3.0",
    "typescript": "~5.6.3"
  },
  "engines": {
    "node": ">=18"
  }
}
