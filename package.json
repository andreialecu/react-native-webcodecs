{
  "name": "react-native-webcodecs",
  "version": "0.1.1",
  "description": "WebCodecs (VideoEncoder, VideoDecoder, AudioEncoder, AudioDecoder, VideoFrame, AudioData) for React Native on VideoToolbox, AudioToolbox and MediaCodec, for Mediabunny and react-native-webgpu",
  "main": "lib/commonjs/index",
  "module": "lib/module/index",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src/**",
    "lib/**",
    "!**/__tests__/**",
    "ios/**",
    "android/build.gradle",
    "android/CMakeLists.txt",
    "android/src/**",
    "nitrogen/**",
    "nitro.json",
    "*.podspec",
    "react-native.config.js"
  ],
  "scripts": {
    "test": "NODE_OPTIONS='--experimental-require-module' jest -i",
    "test:unit": "jest -c jest.unit.config.js",
    "test:cpp": "mkdir -p android/build/test-cpp && c++ -std=c++20 -Wall -Wextra -Werror -I android/src/main/cpp -o android/build/test-cpp/audio_rules android/src/test/cpp/audio_rules_test.cpp && android/build/test-cpp/audio_rules && c++ -std=c++20 -Wall -Wextra -Werror -I android/src/main/cpp -o android/build/test-cpp/encoder_attempts android/src/test/cpp/encoder_attempts_test.cpp && android/build/test-cpp/encoder_attempts && c++ -std=c++20 -Wall -Wextra -Werror -I android/src/main/cpp -o android/build/test-cpp/timestamps android/src/test/cpp/timestamps_test.cpp && android/build/test-cpp/timestamps",
    "test:jvm": "cd example/android && ./gradlew :react-native-webcodecs:testDebugUnitTest -PreactNativeArchitectures=arm64-v8a",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0 --cache --fix && yarn example lint",
    "tsc": "tsc --noEmit && yarn example tsc",
    "build": "bob build",
    "specs": "nitrogen --logLevel=\"debug\"",
    "release": "semantic-release",
    "clang-format": "find android/src/main/cpp -iname \"*.hpp\" -o -iname \"*.cpp\" | xargs clang-format -i",
    "example": "yarn workspace Example",
    "reset": "rm -rf node_modules example/node_modules && yarn install && rm -rf example/ios/Pods example/ios/Podfile.lock && pod install --project-directory=example/ios"
  },
  "keywords": [
    "react-native",
    "webcodecs",
    "videoencoder",
    "videodecoder",
    "mediabunny",
    "webgpu",
    "video",
    "h264",
    "aac",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreialecu/react-native-webcodecs.git"
  },
  "author": "Andrei Alecu (https://github.com/andreialecu)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/andreialecu/react-native-webcodecs/issues"
  },
  "homepage": "https://github.com/andreialecu/react-native-webcodecs#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.7",
    "@types/react": "^19.2.0",
    "@types/ws": "^8.5.10",
    "@webgpu/types": "0.1.65",
    "clang-format": "^1.8.0",
    "eslint": "9.35.0",
    "eslint-config-react-native-wcandillon": "5.0.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "^28.8.2",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "mediabunny": "1.66.2",
    "nitrogen": "0.37.2",
    "prettier": "^3.0.3",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.23.2",
    "react-native-nitro-modules": "0.37.2",
    "react-native-webgpu": "0.23.0",
    "semantic-release": "^25.0.9",
    "semantic-release-yarn": "^3.0.2",
    "typescript": "^5.2.2",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "react-native": ">=0.76.0",
    "react-native-nitro-modules": ">=0.37.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "workspaces": [
    "example"
  ],
  "resolutions": {
    "@types/react": "^19.2.0",
    "@webgpu/types": "^0.1.42",
    "react-native-webgpu@0.23.0": "patch:react-native-webgpu@npm%3A0.23.0#./.yarn/patches/react-native-webgpu-npm-0.23.0-50f3d74c47.patch",
    "react-native-skia@3.10.0": "patch:react-native-skia@npm%3A3.10.0#./.yarn/patches/react-native-skia-npm-3.10.0-c316c6c886.patch"
  },
  "packageManager": "yarn@3.6.4"
}
