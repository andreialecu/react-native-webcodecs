{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "webcodecs"
  ],
  "ios": {
    "iosModuleName": "NitroWebCodecs"
  },
  "android": {
    "androidNamespace": [
      "webcodecs"
    ],
    "androidCxxLibName": "NitroWebCodecs"
  },
  "autolinking": {
    "WebCodecs": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridWebCodecs"
      },
      "android": {
        "language": "c++",
        "implementationClassName": "HybridWebCodecs"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
